# 管理 VM（Linux）のカーネル設定。`make allnoconfig` にこのファイルの設定を重ねる（cargo xtask linux）
#
# 方針: HV の起動経路を確かめやすいよう、シリアルコンソールと initramfs のシェルに必要なものだけを有効にする

# ログとコンソール
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# initramfs（無圧縮の cpio を使うので、伸長器は不要）
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y

# プラットフォーム。デバイスは管理 VM にパススルーする
CONFIG_ACPI=y
CONFIG_PCI=y

# 管理 VM はすべての CPU で動く（docs/smp.md）
CONFIG_SMP=y

# HV がロード先を決められるようにする。KASLR は使わない（起動経路の切り分けを簡単にするため）
CONFIG_RELOCATABLE=y
# CONFIG_RANDOMIZE_BASE is not set
