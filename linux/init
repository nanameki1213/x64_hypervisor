#!/bin/busybox sh
# 管理 VM の initramfs の /init（cargo xtask linux が initrd.img に入れる）
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox --install -s /bin

# cargo xtask test はこの行を成功判定に使う（xtask/src/main.rs の GUEST_OK_MARKER）
echo "[guest] initramfs ok"
exec setsid cttyhack sh
